# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #

# you can choose themes from $HOME/.config/kitty/kitty-themes/
include ./kitty-themes/01-Wallust.conf

font_family FantasqueSansM Nerd Font Mono Bold
font_size 16.0
bold_font auto
italic_font auto
bold_italic_font auto

background_opacity 0.9
dynamic_background_opacity 1
confirm_os_window_close 0

# Animated cursor
# Tắt quyền tự ý đổi con trỏ của shell để nhường quyền cho file config
shell_integration enabled no-cursor

# Chọn hình dạng con trỏ mong muốn (block, beam, underline)
cursor_shape beam
cursor_beam_thickness 1.5

# Cấu hình hiệu ứng nhấp nháy mượt mà kiểu linear (nếu bạn muốn hiệu ứng chạy đều)
cursor_blink_interval -1
cursor_stop_blinking_after 15.0

# Nếu bạn muốn bật hiệu ứng vệt đuôi con trỏ (cursor trail) đang rất hot trên Kitty:
cursor_trail 200
# change to x11 or wayland or leave auto
linux_display_server auto

scrollback_lines 2000
wheel_scroll_min_lines 1

enable_audio_bell no

window_padding_width 4
# selection_foreground none
# selection_background none
# foreground #dddddd
# background #000000
# cursor #dddddd

scrollback_pager_history_size 10


# BEGIN_KITTY_THEME
# Ayu
include current-theme.conf
# END_KITTY_THEME
