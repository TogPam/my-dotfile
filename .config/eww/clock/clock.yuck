;; ==========================================
;; BIẾN LẤY DỮ LIỆU (POLLING VARIABLES)
;; ==========================================
(defpoll time :interval "1s" "date '+%H:%M:%S'")
(defpoll date :interval "1h" "date '+%A, %d %B %Y'")

;; ==========================================
;; GIAO DIỆN WIDGET (WIDGET STRUCTURE)
;; ==========================================
(defwidget clock_module []
  (eventbox :class "clock-event" 
    (box :class "clock-box" :orientation "v" :space-evenly false :halign "end"
      (label :class "time" :text time)
      (label :class "date" :text date)
    )
  )
)

;; ==========================================
;; KHAI BÁO CỬA SỔ (DESKTOP WINDOW)
;; ==========================================
(defwindow desktop_clock
  :monitor 0
  :geometry (geometry :x "40px"
                      :y "40px"
                      :width "300px"
                      :height "150px"
                      :anchor "bottom right")
  :stacking "bottom"       ;; Ép widget nằm dưới cùng, sát màn hình nền
  :exclusive false         ;; Không chiếm không gian của cửa sổ ứng dụng khác
  :focusable false         ;; Không nhận focus bàn phím
  (clock_module)
)
