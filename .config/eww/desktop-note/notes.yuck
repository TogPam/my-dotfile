;; =========================================================
;; DESKTOP NOTES
;; =========================================================


;; Nội dung ô nhập
(defvar note_input_text "")
(defvar notes_json "[]")
;; ID note đang chỉnh sửa
;; "" = đang ở chế độ thêm mới
(defvar note_edit_id "")

;; =========================================================
;; ICON FLOAT TRÊN DESKTOP
;; =========================================================

(defwindow note_icon
  :monitor 0
  :geometry (geometry
    :x "20px"
    :y "20px"
    :width "50px"
    :height "50px"
    :anchor "top right"
  )
  :stacking "bottom"
  :exclusive false
  :focusable false
  :windowtype "utility"
  :wm-ignore false

  (button
    :class "note-icon-btn"
    :onclick "eww open --toggle note_board"
    "󰎞"
  )
)

;; =========================================================
;; NOTE BOARD
;; =========================================================

(defwindow note_board
  :title "note_board"
  :monitor 0
  :geometry (geometry
    :x "20px"
    :y "80px"
    :width "380px"
    :height "520px"
    :anchor "top right"
  )
  :windowtype "utility"
  :wm-ignore false
  :focusable true

  (box
    :class "note-container"
    :orientation "v"
    :space-evenly false


    ;; =====================================================
    ;; HEADER
    ;; =====================================================

    (box
      :class "note-header"
      :orientation "h"
      :space-evenly false

      (label
        :class "note-title"
        :text {
          note_edit_id != ""
          ? "📝 Chỉnh sửa ghi chú"
          : "📝 Ghi chú"
        }
        :halign "start"
        :hexpand true
      )

      (button
        :class "note-close"
        :onclick "eww close note_board"
        :halign "end"
        "󰅖"
      )
    )


    ;; =====================================================
    ;; NOTE LIST
    ;; =====================================================

    (scroll
      :class "note-scroll"
      :vscroll true
      :hscroll false
      :vexpand true

      (box
        :orientation "v"
        :space-evenly false
        :spacing 12
        :class "note-list"

        (for note in notes_json

          (box
            :class "note-item"
            :orientation "h"
            :space-evenly false
            :spacing 6


            ;; ---------------------------------------------
            ;; TEXT
            ;; ---------------------------------------------

            (label
              :class "note-text"
              :text "${note.text}"
              :wrap true
              :halign "start"
              :valign "center"
              :hexpand true
            )


            ;; ---------------------------------------------
            ;; EDIT
            ;; ---------------------------------------------

            (button
              :class "note-action-btn note-edit-btn"
              :onclick "eww update note_edit_id='${note.id}' && eww update note_input_text='${note.text}'"
              "󰏫"
            )


            ;; ---------------------------------------------
            ;; DELETE
            ;; ---------------------------------------------

            (button
              :class "note-action-btn note-del-btn"
              :onclick "~/.config/eww/desktop-note/notes.sh delete '${note.id}'"
              "󰆴"
            )
          )
        )
      )
    )


    ;; =====================================================
    ;; INPUT AREA
    ;; =====================================================

    (box
      :class "note-input-container"
      :orientation "h"
      :space-evenly false

      (input
        :class "note-input"
        :value note_input_text

        ;; Không truyền text trực tiếp cho shell.
        ;; EWW lưu nó vào note_input_text.
        :onchange "eww update note_input_text='{}'"

        ;; Enter:
        ;; - note_edit_id == ""  => ADD
        ;; - note_edit_id != ""  => UPDATE
        :onaccept "~/.config/eww/desktop-note/notes.sh save"

        :hexpand true
      )


      ;; SAVE BUTTON

      (button
        :class "note-save-btn"
        :onclick "~/.config/eww/desktop-note/notes.sh save"
        {
          note_edit_id != ""
          ? "Lưu"
          : "+"
        }
      )


      ;; CANCEL EDIT

      (button
        :class "note-cancel-btn"
        :visible {note_edit_id != ""}
        :onclick "eww update note_edit_id='' && eww update note_input_text=''"
        "Hủy"
      )
    )
  )
)
